# Keep the build context small and free of machine-specific state (see Dockerfile).
.git
.github
.claude
node_modules
.cache
.venv*
**/__pycache__
test
logs
*.log
docs/img
# the image needs only the research JSON tables (server/sim/nodeData.js fallback), not the notes
docs/research/*.md
# game art is mounted at runtime or downloaded with --build-arg FETCH_ASSETS=1, never sent from the host
public/assets
# generated from node_modules inside the image
public/vendor
scripts/service.env.cmd
.DS_Store
Thumbs.db
.env
.env.*
# host-private announcements and server settings (SP_SERVER_SETTINGS_DIR / SP_ANNOUNCEMENTS_DIR);
# the capacity branch writes these under runtime/, which is no part of the image
runtime
# per-machine manifest of locally extracted assets
data/local-assets.json
